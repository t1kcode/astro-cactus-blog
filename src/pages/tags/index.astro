---
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();

// 收集每个标签的元数据
interface TagMeta {
	name: string;
	count: number;
	latestDate: Date;
	isArchived: boolean;
}

const tagMap = new Map<string, TagMeta>();

for (const post of allPosts) {
	const isArchived = post.data.categories?.includes("封档") ?? false;
	for (const tag of post.data.tags) {
		const existing = tagMap.get(tag);
		if (!existing) {
			tagMap.set(tag, {
				name: tag,
				count: 1,
				latestDate: post.data.publishDate,
				isArchived,
			});
		} else {
			existing.count++;
			if (post.data.publishDate > existing.latestDate) {
				existing.latestDate = post.data.publishDate;
			}
			if (!isArchived) {
				existing.isArchived = false;
			}
		}
	}
}

// 排序：封档排最后 → 其余按最新日期倒序
const tags = Array.from(tagMap.values()).sort((a, b) => {
	if (a.isArchived !== b.isArchived) {
		return a.isArchived ? 1 : -1;
	}
	return b.latestDate.getTime() - a.latestDate.getTime();
});

const meta = {
	description: "所有标签",
	title: "Tags",
};
---

<style>
	@keyframes tag-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.tag-animate {
		animation: tag-in 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
	}
</style>

<PageLayout {meta}>
	<h1 class="title mb-12">Tags</h1>

	<div class="flex min-h-[40vh] flex-wrap content-start gap-3">
		{
			tags.map((tag, i) => (
				<a
					href={`/tags/${tag.name}/`}
					class:list={[
						"tag-animate border-global-text/5 inline-block rounded-full border select-none",
						"px-4 py-[0.35rem] text-sm leading-snug",
						"bg-global-text/[0.03]",
						"transition-[transform,box-shadow,border-color] duration-200 ease-out",
						"hover:border-[#2bbc8a]/30 hover:bg-[#2bbc8a]/5 hover:shadow-[0_0_16px_rgba(43,188,138,0.08)]",
						"hover:-translate-y-0.5 hover:scale-[1.02]",
						"active:scale-[0.98] active:duration-75",
						tag.isArchived ? "text-muted" : "text-global-text",
					]}
					style={`animation-delay: ${Math.min(i * 0.03, 1.2)}s`}
					title={`${tag.count} 篇文章${tag.isArchived ? "（封档）" : ""}`}
				>
					<span>{tag.name}</span>
					<span class="ml-1.5 inline-block align-top text-[0.85em] font-normal text-[#091912] tabular-nums opacity-40">
						{tag.count}
					</span>
				</a>
			))
		}
	</div>
</PageLayout>
