---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}

const {
	heading: { children, depth, slug, text },
} = Astro.props;
---

<li class={depth > 2 ? "ms-4" : ""}>
	<a
		class={`
			line-clamp-2 block py-1.5 text-sm transition-colors duration-200
			${depth <= 2 ? "font-medium text-accent-2 hover:text-accent" : "text-muted hover:text-accent-2"}
			${depth === 2 ? "mt-2" : "mt-1"}
		`}
		href={`#${slug}`}
	>
		{text}
	</a>
	{
		!!children.length && (
			<ol class="mt-1 space-y-1">
				{children.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ol>
		)
	}
</li>
